# Copy to .env and fill in. Everything here is optional; the benchmark runs without it.

# LangSmith tracing and experiments (https://smith.langchain.com > Settings > API Keys)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=supplygen-poc

# Local LLM for headline normalisation and approver briefings (Ollama must be running)
SUPPLYGEN_MODEL=qwen3:8b
OLLAMA_URL=http://localhost:11434

# Live commodity prices (https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# Country whose festival calendar drives demand signals in live mode
SALES_COUNTRY=IN
